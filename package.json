{
  "displayName": "Homebridge Eltako for MiniSafe2",
  "name": "homebridge-eltako-minisafe2",
  "version": "2.5.0",
  "description": "A Homebridge plugin to connect local Eltako installations to HomeKit. Requires a MiniSafe2.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/awaescher/homebridge-eltako-minisafe2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awaescher/homebridge-eltako-minisafe2.git"
  },
  "bugs": {
    "url": "https://github.com/awaescher/homebridge-eltako-minisafe2/issues"
  },
  "engines": {
    "node": "^18.19.0 || ^20.9.0 || 22 || 24",
    "homebridge": "^1.6.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "lint:fix": "eslint src/**.ts --max-warnings=0 --fix",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "test": "mocha --require ts-node/register 'src/**/*.test.ts'",
    "prepublishOnly": "npm run lint && npm run build",
    "release": "semantic-release"
  },
  "keywords": [
    "homebridge-plugin",
    "enocean",
    "mediola",
    "eltako",
    "eltako14",
    "minisafe",
    "minisafe2"
  ],
  "dependencies": {
    "axios": "^1.12.2"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.130",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "chai": "^6.2.2",
    "eslint": "^8.45.0",
    "homebridge": "^1.7.0",
    "mocha": "^11.7.5",
    "nodemon": "^2.0.22",
    "rimraf": "^3.0.2",
    "semantic-release": "^24.2.0",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  }
}
